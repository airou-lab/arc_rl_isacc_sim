#usda 1.0
(
    defaultPrim = "Track"
    upAxis = "Z"
)

def Xform "Track"
{
    # Scale world by 0.125 to convert the 8.0x track to 1.0x metric scale
    double3 xformOp:scale = (0.125, 0.125, 0.125)
    uniform token[] xformOpOrder = ["xformOp:scale"]

    def "Scene" (
        prepend references = @./no_graph_sim_clean_1x.usda@
    )
    {
    }
}
